[
 {
  "id": "alm-vtk-phone-in",
  "name": "ALMANAC · Artifacts · received message",
  "find": "^[ \\t]*»[ \\t]*([^:\\n]{1,40}):[ \\t]*(.+)$",
  "rep": "<span style=\"display:block;width:fit-content;max-width:82%;margin:7px 0;padding:8px 12px;border-radius:16px;font:14px/1.4 system-ui,sans-serif;background:#262a35;color:#eef0f5;border-bottom-left-radius:5px\"><b style=\"display:block;font-size:11px;letter-spacing:.06em;color:#9aa4bd;margin-bottom:2px\">$1</b>$2</span>",
  "flags": "gm",
  "order": 30,
  "description": ""
 },
 {
  "id": "alm-vtk-phone-out",
  "name": "ALMANAC · Artifacts · sent message",
  "find": "^[ \\t]*«[ \\t]*(.+)$",
  "rep": "<span style=\"display:block;width:fit-content;max-width:82%;margin:7px 0;padding:8px 12px;border-radius:16px;font:14px/1.4 system-ui,sans-serif;margin-left:auto;background:linear-gradient(160deg,#3b82f6,#2563eb);color:#fff;border-bottom-right-radius:5px\">$1</span>",
  "flags": "gm",
  "order": 31,
  "description": ""
 },
 {
  "id": "alm-vtk-menu",
  "name": "ALMANAC · Artifacts · price line",
  "find": "^[ \\t]*([^\\n\\[\\]\"“”<>]{1,60}?)[ \\t]+\\.{4,}[ \\t]+([^\\n\\[\\]<>]{1,24})$",
  "rep": "<span style=\"display:flex;gap:.5em;align-items:baseline\"><span>$1</span><span style=\"flex:1;border-bottom:2px dotted currentColor;opacity:.35;transform:translateY(-.3em)\"></span><span>$2</span></span>",
  "flags": "gm",
  "order": 32,
  "description": ""
 },
 {
  "id": "alm-vtk-route",
  "name": "ALMANAC · Artifacts · route leg",
  "find": "^[ \\t]*→[ \\t]*(.+)$",
  "rep": "<span style=\"display:flex;gap:.6em;align-items:baseline\"><span style=\"flex:none;width:.6em;height:.6em;border-radius:50%;border:2px solid currentColor;transform:translateY(.05em)\"></span><span>$1</span></span>",
  "flags": "gm",
  "order": 33,
  "description": ""
 },
 {
  "id": "alm-vtk-redacted",
  "name": "ALMANAC · Artifacts · redaction",
