  "description": ""
 },
 {
  "id": "alm-vtk-meter",
  "name": "ALMANAC · Artifacts · meter",
  "find": "^[ \\t]*\\[meter=([^|\\]\\n]{1,40})\\|(\\d{1,6})\\|(\\d{1,6})\\][ \\t]*$",
  "rep": "<span style=\"display:grid;grid-template-columns:minmax(70px,auto) 1fr auto;align-items:center;gap:10px;margin:6px 0;font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.06em\"><span style=\"text-transform:uppercase;opacity:.85\">$1</span><span style=\"height:8px;border-radius:9px;background:rgba(127,127,127,.25);overflow:hidden\"><span style=\"display:block;height:100%;width:min(100%,calc($2 / $3 * 100%));border-radius:9px;background:linear-gradient(90deg,#5b8cff,#9f7bff)\"></span></span><span style=\"font-variant-numeric:tabular-nums;opacity:.8\">$2/$3</span></span>",
  "flags": "gm",
  "order": 35,
  "description": "A stat bar: [meter=Label|current|max]."
 },
 {
